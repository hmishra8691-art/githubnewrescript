{
  "name": "@rescript/analytics",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "default": "./dist/export/index.js"
    },
    "./story": {
      "types": "./dist/story/index.d.ts",
      "default": "./dist/story/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/fixture.js",
    "!dist/**/fixture.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js dist/stats/*.test.js dist/analyses/*.test.js dist/export/*.test.js dist/geo/*.test.js dist/story/*.test.js dist/models/*.test.js dist/conjoint/*.test.js"
  },
  "dependencies": {
    "@rescript/engine": "workspace:*",
    "@rescript/schema": "workspace:*",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "opentype.js": "1.3.4",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@rescript/designs": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/opentype.js": "1.3.8",
    "typescript": "^5.6.3"
  }
}
