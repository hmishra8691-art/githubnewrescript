{
  "name": "@rescript/access",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mfa": {
      "types": "./dist/mfa.d.ts",
      "default": "./dist/mfa.js"
    },
    "./respondent": {
      "types": "./dist/respondent.d.ts",
      "default": "./dist/respondent.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3"
  }
}
