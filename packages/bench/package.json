{
  "name": "@rescript/bench",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js",
    "bench": "node dist/cli.js"
  },
  "dependencies": {
    "@rescript/analytics": "workspace:*",
    "@rescript/engine": "workspace:*",
    "@rescript/import": "workspace:*",
    "@rescript/quality": "workspace:*",
    "@rescript/schema": "workspace:*",
    "@rescript/templates": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3"
  },
  "bin": {
    "rescript-bench": "./dist/cli.js"
  }
}
