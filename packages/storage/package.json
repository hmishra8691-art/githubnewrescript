{
  "name": "@rescript/storage",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./upload": {
      "types": "./dist/upload.d.ts",
      "default": "./dist/upload.js"
    },
    "./uploader": {
      "types": "./dist/uploader.d.ts",
      "default": "./dist/uploader.js"
    },
    "./completion": {
      "types": "./dist/completion.d.ts",
      "default": "./dist/completion.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3"
  }
}
