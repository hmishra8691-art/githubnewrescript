{
  "name": "@rescript/templates",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@rescript/designs": "workspace:*",
    "@rescript/engine": "workspace:*",
    "@rescript/schema": "workspace:*"
  },
  "devDependencies": {
    "@rescript/exporters": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "^5.6.3"
  }
}
