+  const columns = React.useMemo(() => GRID_COLUMNS.filter((c) => prefs.columns.includes(c.id)), [prefs.columns]);
+  const rowHeight = ROW_HEIGHT[prefs.density];
+  const byId = React.useMemo(() => new Map(s.def.questions.map((q) => [q.id, q])), [s.def]);
