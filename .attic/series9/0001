+  }
+}
+
+/* ---------------------------------------------------------- ⌘K path */
+{
+  await page.click('[data-testid="mode-grid"]');
+  await page.waitForSelector('[data-testid="grid-view"]');
+  await page.keyboard.press(`${mod}+k`);
