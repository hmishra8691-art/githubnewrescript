+}
+
+/* ------------------------------------------------------- the model route */
+{
+  const r = await page.evaluate(async () => {
+    const res = await fetch("/api/ai/logic", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ text: "show Q6 when Q3 > 1", context: "Q3 (AGE) numeric" }) });
