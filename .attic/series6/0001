+  const uid = opts.uid ?? ((p: string) => `${p}_${Date.now().toString(36)}${(seq++).toString(36)}`);
+  const issues: Issue[] = [];
+  const mapping: ImportMapEntry[] = [];
+  const existing = opts.existing ?? null;
+
