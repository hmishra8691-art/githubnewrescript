+
+const IDENT = /^[A-Za-z_][A-Za-z0-9_]*$/;
+const safeIdent = (s: string) => { let t = s.trim().replace(/[^A-Za-z0-9_]+/g, "_").replace(/_{2,}/g, "_").replace(/^_+|_+$/g, ""); if (!t) t = "V"; if (/^\d/.test(t)) t = `Q${t}`; return t; };
