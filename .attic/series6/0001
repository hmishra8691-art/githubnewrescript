+
+function joinAndOr(parts: { conj: string; e: CExpr }[]): CExpr {
+  const ors: CExpr[][] = [[]];
+  for (const p of parts) {
+    if (/^or$/i.test(p.conj) && ors[ors.length - 1].length) ors.push([]);
+    ors[ors.length - 1].push(p.e);
