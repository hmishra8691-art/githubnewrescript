+    merge = { unchanged: [], changed: [], added: [] };
+    const byVar = new Map(existing.questions.map((q) => [q.variableName.toUpperCase(), q]));
+    for (const cq of c.questions) {
+      const ex = byVar.get(safeIdent(cq.variable).toUpperCase());
+      if (!ex) continue;
