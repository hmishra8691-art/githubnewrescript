# =====================================================================
# Copy to apps/studio/.env.local AND apps/runtime/.env.local
# (or set as environment variables in Vercel — never commit real values)
#
# The complete set the two apps read. `/platform` in the Studio reports which
# of these are set on a running instance, and what breaks while one is not —
# so the answer to "why are invitation links relative" is a page rather than
# a search through this file.
# =====================================================================

# ---------------------------------------------------------------------
# WHICH DEPLOYMENT THIS IS  (§45)  — Studio
#
# development | staging | production. Set it. Two instances of this platform
# look identical, and publish, deploy, purge and freeze are all one click; a
# person who believes they are in staging and is in production finds out
# afterwards. A non-production instance shows a banner on every page, and the
# absence of that banner is the signal that this is the real one.
#
# Unset, the tier is inferred from NODE_ENV — which errs towards PRODUCTION
# for anything built and served, because that is the safer mistake.
# ---------------------------------------------------------------------
RESCRIPT_ENV=development

# The release this instance is running, shown on /platform. On Vercel,
# VERCEL_GIT_COMMIT_SHA is used automatically and this can stay empty.
RESCRIPT_RELEASE=

# ---------------------------------------------------------------------
# THE DATABASE  — Studio and runtime, both required
# ---------------------------------------------------------------------
# Supabase project URL. Its project reference (the first host label) is shown
# on /platform so you can see which database an instance is pointed at.
SUPABASE_URL=https://your-project.supabase.co

# Service role key — Supabase Dashboard → Project Settings → API keys → service_role.
# SERVER-ONLY: used by API routes; it is never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anon key. Used for ONE thing: the password exchange at sign-in. Without it
# the platform falls back to the service key for that call, which works and is
# the wrong key to use for it — set this.
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# URLS
# ---------------------------------------------------------------------
# Where the respondent runtime is reachable. Every survey link, test link and
# QR code is built from this, so a wrong value here is 4 000 broken
# invitations. Studio only.
NEXT_PUBLIC_RUNTIME_URL=http://localhost:3001

# RUNTIME-01 (audit 2026-10-16). What the respondent runtime does when a saved
# page does not add up when replayed with the survey's own rules — an answer
# outside its range on a page already passed, a "complete" that never reaches
# an end, an unknown question id. Runtime only.
#   off      store whatever the browser posted (the pre-audit behaviour)
#   log      replay, write one [rescript:save] submission check line per
#            problem with wouldRefuse=true/false, store anyway   (default)
#   enforce  refuse a payload with a hard problem (HTTP 422, the engine's
#            own message shown to the respondent). TEST sessions are never
#            refused (a test link may start mid-survey).
# Run with `log` first; switch to `enforce` once the logs show no wouldRefuse
# lines from honest traffic.
RUNTIME_SERVER_VALIDATION=log

# D7 (S0b, audit 2026-10-30). The replay above also recomputes what the engine
# derives from the posted answers and the row's seed — derived (hidden /
# calculated) punches and recompute:"always" punches, calculations, loop and
# masking variables — and compares the exact-balance assignments
# (RANDOMIZER_<ID>, <VAR>_VERSION) with the claims the server stored. Each
# difference is a soft server_mismatch in the submission-check log line
# (question or variable, posted vs server; open-end text is never logged).
# Needs RUNTIME_SERVER_VALIDATION other than off (it runs inside the replay).
# Runtime only. Does not change RUNTIME_SERVER_VALIDATION.
#   off    no comparison
#   log    compare and log, store what was posted                (default)
#   store  store the server's values for those derived fields instead
RUNTIME_SERVER_RECOMPUTE=log

# S0b (audit 2026-10-30). The respondent runtime's Content-Security-Policy
# (apps/runtime/lib/csp.ts, sent by apps/runtime/middleware.ts). Runtime only.
#   enforce  (default) block fetch / XHR / sendBeacon / WebSocket / EventSource
#            to anything but the runtime itself and the origins built from this
#            file at boot (SUPABASE_URL, R2 storage or MEDIA_STORAGE_URL,
#            AI_REALTIME_API_URL, LIVEKIT_URL); also form-action 'self',
#            base-uri 'self', object-src 'none'. Images, media and scripts are
#            NOT restricted — a stricter img/media/script policy is sent as
#            Content-Security-Policy-Report-Only (browser console only; there is
#            no report endpoint).
#   report   send the policy as Report-Only (nothing blocked)
#   off      no CSP headers
RUNTIME_CSP=enforce
# Extra origins the respondent page may connect to (space-separated, with the
# scheme: https://cdn.example.com wss://rt.example.com). Runtime only.
RUNTIME_CSP_CONNECT=

# The shared secret Vercel Cron presents when it drains the Rescript Interviews
# job queue (/api/cron/jobs, every five minutes). UNSET MEANS THE ROUTE REFUSES
# EVERYTHING — an open endpoint that drains a queue is one anybody can use to
# spend the wallet. Studio uses the same variable for its own cron.
CRON_SECRET=

# Which OTHER applications may be handed this Studio's session, comma-separated
# and exact. Interviews is on its own origin and cannot read the session cookie
# (it is host-only, and vercel.app is a public suffix), so sign-in goes through
# a single-use code. Unset means no application may receive one. Studio only.
# See docs/AUTH-HANDOFF.md.
AUTH_HANDOFF_ORIGINS=http://localhost:3002

# This app's own public origin. Candidate links are built from it, and a
# sign-in code is bound to it at both ends, so it must match the Studio's
# AUTH_HANDOFF_ORIGINS entry exactly. Interviews only.
INTERVIEWS_PUBLIC_URL=http://localhost:3002

# Where Interviews sends somebody to sign in. Interviews only.
NEXT_PUBLIC_STUDIO_URL=http://localhost:3000

# Absolute base for the links this platform GENERATES for humans to send:
# password resets and project invitations. Unset, they come out relative and
# are unusable in an email. Studio only.
STUDIO_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------
# SALTS  — pseudonymous identifiers, never reversible
# ---------------------------------------------------------------------
# Salt for the IP hashes used in sign-in throttling and session records.
# Studio only. Unset, a shared default is used — which means every
# unconfigured instance hashes an address the same way.
AUTH_HASH_SALT=

# Salt for respondent and device identifiers in response quality (§26).
# BOTH APPS, and it must be the SAME VALUE in both: the runtime writes the
# hashes and the Studio reads them, so two different salts means duplicate
# detection silently stops matching.
QUALITY_HASH_SALT=

# Key for cross-project respondent matching — Respondent Trust ID (0083).
# RUNTIME. At least 32 bytes, as 64 hex characters or base64:
#   openssl rand -hex 32
#
# DELIBERATELY NOT QUALITY_HASH_SALT. That salt is applied per SURVEY, which
# makes a device hash in one study incomparable with one in another — a real
# privacy property that exists on purpose. Matching people ACROSS projects
# relaxes it, so it is relaxed narrowly: its own key, its own table
# (identity_match_tokens), its own retention, and only for organisations that
# have opted in.
#
# UNSET, CROSS-VENDOR DEDUPLICATION IS SIMPLY OFF. There is no default and no
# fallback: a system that silently derived matchable tokens under a guessable
# key would be worse than one that refused to run, because nobody would find
# out until the tokens were already written. Per-panel deduplication (0072) is
# unaffected and keeps working.
RTID_MATCH_KEY=

# Retired RTID keys that can still be matched against, comma-separated.
# Rotation looks up under every key and writes under the current one, so an
# identity written months ago is still found and is re-written under the new
# key the next time it is seen. Nothing has to be re-derived in bulk.
RTID_MATCH_KEY_PREVIOUS=

# ---------------------------------------------------------------------
# INTEGRATIONS_SECRET_KEY  — Studio AND Runtime. BOTH apps need the SAME value.
#
#   openssl rand -hex 32
#
# The master key for envelope encryption (AES-256-GCM). 32 random bytes, as 64
# hex characters or base64.
#
# CHECK WHETHER THIS IS ALREADY SET BEFORE GENERATING ONE. It does not belong
# to any single feature: it already seals users' own AI provider keys (BYOK),
# alert channel secrets, panel signing secrets in the runtime, and now vendor
# API credentials. Replacing a key that is already in use does not re-encrypt
# anything — it makes every secret sealed under the old one permanently
# unopenable, and they must all be entered again.
#
# ROTATE, DO NOT REPLACE. Move the old value to INTEGRATIONS_SECRET_KEY_PREVIOUS
# and put the new one here. Everything still opens; new writes use the new key.
#
# UNSET, NOTHING THAT NEEDS IT IS STORED. Each route refuses with a reason
# rather than writing a secret in the clear — a plaintext credential in a
# database column is worse than a feature that will not switch on.
INTEGRATIONS_SECRET_KEY=

# Retired master keys that can still OPEN what they sealed, comma-separated.
# Nothing is re-encrypted in bulk: a secret is re-sealed under the current key
# the next time it is written.
INTEGRATIONS_SECRET_KEY_PREVIOUS=

# ---------------------------------------------------------------------
# VENDOR WEBHOOKS  — Studio only (0086)
#
# The signing secret a sample vendor uses on the events it POSTs to
# /api/webhooks/vendors/<vendor>. UNLIKE RTID_MATCH_KEY, THIS IS NOT OURS TO
# GENERATE: the vendor issues it and signs with it, and we only verify. On
# Prolific it comes back as `value` from POST /api/v1/hooks/secrets/ — once.
# Calling that endpoint again DELETES the existing secret and issues a new
# one, so store the value the first time and do not re-create it casually:
# every event signed with the old secret fails verification until this
# variable is updated.
#
# UNSET, THE DOOR IS SHUT RATHER THAN OPEN. Every delivery is recorded with
# the verdict `no_secret` and quarantined; none is acted on. An endpoint that
# processed unsigned events because nobody configured a secret would be an
# open door that looks like a working integration.
#
# ONE VARIABLE, ONE VENDOR. Today only Prolific has a signing scheme in
# WEBHOOK_SPECS, so a single value is enough. A second live vendor needs this
# split per vendor (VENDOR_WEBHOOK_SECRET_PROLIFIC, _CINT, …) — the route
# reads one variable today and that is a real limit, not a design.
VENDOR_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# MAIL  — Studio only (the runtime never sends anything)
#
# Without these the platform still works: invitations hand back a link for a
# human to send, and that is the honest fallback. What does NOT work without
# them is password reset, which cannot be completed by any other route.
# ---------------------------------------------------------------------
# Resend API key (https://resend.com → API Keys). Server-only.
RESEND_API_KEY=

# The transactional From address. Must be on a domain VERIFIED with the
# provider — SPF and DKIM records added at your DNS host — or everything you
# send lands in spam. Include a display name: "Rescript <no-reply@example.com>"
MAIL_FROM=

# The From address for RESPONDENT INVITATIONS, which are bulk mail and have
# entirely different deliverability rules. Put it on a separate subdomain
# (invites@send.example.com) so a survey wave that lands in spam folders
# cannot take your password-reset delivery down with it. Falls back to
# MAIL_FROM, which works and is worth fixing.
MAIL_FROM_INVITATIONS=

# Where a reply goes. A respondent who replies to a survey invitation is a
# real person with a real question, and a no-reply address loses it.
MAIL_REPLY_TO=

# THE SAFEGUARD. Outside production, mail is never delivered to its real
# recipient: it goes to this address instead, labelled with who it was really
# for. Unset, a non-production instance sends NOTHING — which is the safe
# default, because a staging copy pointed at a production database holds real
# respondent addresses. Reaching a real inbox needs RESCRIPT_ENV=production.
MAIL_DEV_REDIRECT=

# ---------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------
# Per-project diagnostics (§27) are open outside production and
# platform-admin-only in it. Set to 1 to open them in production too — useful
# while chasing a report of "I cannot save", and worth turning off again.
RESCRIPT_DIAGNOSTICS=


# ---------------------------------------------------------------------
# LANGUAGE MODEL (Studio + runtime; server only — never sent to a browser)
# ---------------------------------------------------------------------
# Intelligent Mode reads every request with its own engine first (edits, logic,
# options, dependencies, impact — no model call). What the engine hands on —
# descriptive requests ("change the screener so under-25s are excluded"),
# generating a questionnaire from a brief, rewording, document cards, narrative
# findings — needs a language model. Unset, the mode is ENGINE ONLY and says so
# on every such request. /api/platform (Administration → Platform) reports
# whether a model is configured.
#
# Base URL of an OpenAI-compatible chat-completions API, e.g.
#   https://api.openai.com/v1          (OpenAI)
#   https://api.anthropic.com/v1/      (Anthropic's compatibility endpoint)
#   fake:                              (the deterministic in-process stand-in —
#                                       development and the browser suites only)
# Optional. The public address of this Studio (https://studio.example.com), used
# for the documentation's sitemap and robots.txt. Unset, the sitemap is relative.
NEXT_PUBLIC_SITE_URL=
AI_API_URL=
# The key for that API (server only; mark it Sensitive on Vercel).
AI_API_KEY=
# The chat model the copilot reasons with. Use a name YOUR provider serves —
# the default, gpt-4o-mini, is OpenAI's and an Anthropic endpoint refuses it.
# A capable model matters here: the copilot answers in a strict JSON shape.
AI_MODEL=
# Optional. A cheaper model for the SMALL tier — short structuring calls
# (reading a hypothesis into its sides, say). Defaults to AI_MODEL.
AI_MODEL_SMALL=
# ---- User-owned AI providers (Settings -> AI & Integrations) ---------------
# Optional. The MASTER KEY of the credential vault: 32 random bytes, as 64 hex
# characters (openssl rand -hex 32) or base64. Researchers can save their own
# AI provider keys only when this is set; each key is sealed with AES-256-GCM
# under a per-key data key wrapped by this master key. It lives ONLY here, never
# in the database: a copy of the tables without it is noise. Back it up
# separately - losing it makes every saved key unreadable (people re-enter
# theirs). Without it nothing is stored and the screen says so; there is no
# unencrypted fallback. Server only; mark it Sensitive on Vercel.
AI_CREDENTIAL_KEY=
# Optional. Retired master keys, comma-separated, that can still OPEN what they
# sealed - set when rotating AI_CREDENTIAL_KEY, drop once nothing uses them.
AI_CREDENTIAL_KEY_PREVIOUS=
# Optional, default off. Let a user's custom AI endpoint use plain http or a
# private/loopback address (a model server on your own network). Leave off on a
# shared installation: it is the guard that keeps a user's endpoint from being
# aimed at this server's internal network. Only for single-tenant installs.
AI_BYOK_ALLOW_PRIVATE_ENDPOINTS=

# Optional. The output ceiling Intelligent mode asks the provider for, in
# tokens (default 32000). Intelligent mode does not ration an answer: it asks
# for this much, a provider that allows less lowers it by itself, and a
# cut-off answer is continued. The wallet holds the EXPECTED size of a call,
# never this ceiling, and is settled with what the provider reported.
AI_MAX_OUTPUT_TOKENS=
# Optional. Most requests to the provider at once, per Studio instance
# (default 6). A 429 halves it for a while and successes widen it again, so a
# busy provider is paced instead of hammered; every request shares one
# cool-down after a Retry-After.
AI_MAX_CONCURRENCY=
# Optional. A SECOND provider, used only when the first cannot answer — rate
# limited past the retries, out of credit, down, or refusing the key. All three
# are required (and the URL must be https): a half-configured fallback is
# ignored and says so once in the log. AI_FALLBACK_MODEL_SMALL is the small tier.
AI_FALLBACK_API_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_MODEL_SMALL=
# Optional. Anthropic keys that are not scoped to a workspace need this; it is
# sent as the anthropic-workspace-id header. Leave unset for other providers.
AI_WORKSPACE_ID=
# Optional. Any other headers the provider needs, as a JSON object, e.g.
# {"OpenAI-Organization":"org_…"}. Cannot override the key or the body type.
AI_API_HEADERS=
# Optional. A vision model for OCR of scanned research documents (defaults to AI_MODEL).
AI_VISION_MODEL=
# Optional. An embeddings model for semantic retrieval over uploaded research
# documents; unset, retrieval is BM25 only (works, just lexical).
AI_EMBEDDINGS_MODEL=
# Optional speech. Transcription is usually a different vendor: a base URL
# serving POST <base>/audio/transcriptions, its key, and the model. Each falls
# back to the chat provider's value; Anthropic has no transcription endpoint.
AI_STT_API_URL=
AI_STT_API_KEY=
AI_STT_MODEL=
# Optional. The text-to-speech model for voice surveys (default tts-1).
AI_TTS_MODEL=
# Optional (runtime). The text-to-speech voice for AI interviews (provider voice id; default alloy).
AI_TTS_VOICE=
# Optional (runtime). A realtime speech-to-speech provider for "Realtime (low latency)" AI
# interviews (OpenAI Realtime over WebRTC). The runtime mints a short-lived client secret per
# interview; this key never reaches the browser. Unset = the option is hidden and /platform says why.
# Only AI_REALTIME_PROTOCOL=openai is accepted (it can be gated: manual responses, transcription, tools).
AI_REALTIME_API_URL=
AI_REALTIME_API_KEY=
AI_REALTIME_MODEL=
AI_REALTIME_VOICE=
AI_REALTIME_TRANSCRIBE_MODEL=
AI_REALTIME_PROTOCOL=

# ---------------------------------------------------------------------
# TRANSLATION (Studio only — keys never reach the browser or a survey)
# ---------------------------------------------------------------------
# Google Cloud Translation, the primary translation provider. Create a key in
# Google Cloud → APIs & Services → Credentials, restrict it to the Cloud
# Translation API, and set it here (mark it Sensitive on Vercel). When set,
# Google translates; the Studio's Translation → Settings card shows
# "Connected" without ever showing the key.
GOOGLE_TRANSLATE_API_KEY=
# Optional: a different endpoint (proxy, regional). Default is Google's v2 REST API.
GOOGLE_TRANSLATE_ENDPOINT=
# Optional: pin the provider — google | ai | fake. Unset, Google is used when
# its key is set, else the AI model (AI_API_URL…), else none (translate by hand).
TRANSLATION_PROVIDER=

# ---------------------------------------------------------------------
# METERED USAGE & WALLETS (simulation mode — no payment processing)
# ---------------------------------------------------------------------
# Nothing to configure for production: wallets, rates, thresholds and the
# pricing model are administered in the Studio (Administration → Billing) and
# stored in the database (migration 0023). The two switches below are for
# development only.
#
# Price the FAKE providers (AI_API_URL=fake:) as if they were the real ones,
# so a developer and the browser suites can watch a wallet drain. Never in
# production: the fake providers cost nothing and must be priced at nothing.
BILLING_SIMULATE_FAKE_COSTS=
# Starting balance of the in-memory wallet the /sandbox Studio uses (default 100).
BILLING_SANDBOX_CREDITS=

# ---------------------------------------------------------------- scheduling
#
# The one secret that makes the delivery cron runnable. `/api/cron/media-delivery`
# sends researcher media and deletes it after 48 hours, so it REFUSES to run
# without this — an unauthenticated route that deletes recordings and sends
# mail is worse than a feature that has not shipped.
#
# Vercel sends it automatically as `Authorization: Bearer $CRON_SECRET` for
# the schedules declared in `apps/studio/vercel.json`. Set it in the project's
# environment variables; any long random string will do.
#
#   openssl rand -base64 32
#
# The schedule is every 10 minutes, which a Vercel plan with minute-level
# crons honours. On Hobby, crons run once a day: delivery would then be up to
# 24 hours late and the 48-hour deletion up to 24 hours overdue, so the
# retention promise in the email would no longer be true. Check the plan
# before switching delivery on for real fieldwork.
CRON_SECRET=

# Delivery links are built from STUDIO_PUBLIC_URL (above). Without it the cron
# has nowhere to point the researcher and marks the delivery failed rather
# than sending a broken link.

# ---------------------------------------------------------------------
# Live sessions (video) — a TURN relay for strict networks. Studio AND runtime.
# Cloudflare TURN (recommended if you use Cloudflare): Cloudflare dashboard →
# Realtime → TURN Server → create a key; it shows the key id and an API token.
# Credentials are minted per person through Cloudflare's API (24 h by default).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# …or any other TURN server: URLs (comma-separated) and either static
# credentials or a coturn `static-auth-secret` (time-limited credentials).
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
WEBRTC_TURN_SECRET=
# credential lifetime in seconds (600–86400; default 21600)
WEBRTC_TURN_TTL_SECONDS=

# =====================================================================
# THE VARIABLES THAT WERE READ AND NEVER DOCUMENTED (platform audit, 2026-11-05)
#
# 39 variables were referenced in code and absent from this file, so a new
# deployment could not be configured from it. They are below, grouped by
# what they govern. Each is optional unless it says otherwise; the default
# is what the code does when the variable is unset.
# =====================================================================

# ---------------------------------------------------------------------
# OBJECT STORAGE — Cloudflare R2 (or any S3-compatible store). Studio, runtime
# AND Interviews: recorded media, chunked uploads, report artifacts, exports.
# Without it media falls back to the memory provider, which is refused in
# production unless *_ALLOW_MEMORY_STORAGE says otherwise (below).
# ---------------------------------------------------------------------
# Either the Cloudflare account id (the endpoint is derived from it) …
R2_ACCOUNT_ID=
# … or the full S3 endpoint, for any other S3-compatible store.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 region (R2 ignores it; default "auto") and path-style addressing (1 for MinIO-style stores)
R2_REGION=
R2_FORCE_PATH_STYLE=
# Interviews only: "memory" keeps recordings in process memory — never in
# production, unless INTERVIEWS_ALLOW_MEMORY_STORAGE=1 is set deliberately.
INTERVIEWS_STORAGE=
INTERVIEWS_ALLOW_MEMORY_STORAGE=
# where the memory provider's URLs point (default http://127.0.0.1:4599)
INTERVIEWS_STORAGE_URL=

# ---------------------------------------------------------------------
# INTELLIGENT MODE — the durable execution engine (0074). Studio.
# All nine take effect and /platform reports their effective values.
# ---------------------------------------------------------------------
# "off" sends every request through a single turn instead of a planned task (default: on)
COPILOT_TASKS=
# how long the page waits before advancing the next slice itself, ms (default 60000)
COPILOT_TASK_ADVANCE_MS=
# "off" stops mirroring step results into the legacy plan rows while the two coexist (default: on)
COPILOT_TASK_DUAL_WRITE=
# on | 1 | true | yes: resume an interrupted task instead of starting over (default: off)
COPILOT_TASK_RESUME=
# the older name for COPILOT_TASK_RESUME; read when the new one is unset
COPILOT_PLAN_RESUME=
# questions per model call by step kind; clamped to sane ranges (5–40, 2–12, 5–40, 10–80)
TASK_BATCH_SIMPLE=20
TASK_BATCH_COMPLEX=6
TASK_BATCH_EDIT=20
TASK_BATCH_LOGIC=
# browser: stream the copilot's reply token by token ("off" to disable; the page also remembers a per-browser choice)
NEXT_PUBLIC_COPILOT_STREAMING=
# development only: the sandbox's in-memory tasks are dumped to a file so a restart keeps them.
# RESCRIPT_TASKS_DUMP=off disables it; RESCRIPT_TASKS_DIR moves the file (default: the OS temp dir)
RESCRIPT_TASKS_DUMP=
RESCRIPT_TASKS_DIR=

# ---------------------------------------------------------------------
# GEOCODING — the runtime's address lookup for location questions. Runtime.
# A Nominatim-compatible endpoint; "fake:" for the deterministic test provider.
# ---------------------------------------------------------------------
GEOCODE_API_URL=
# sent as ?key= for services that take one
GEOCODE_API_KEY=
# Nominatim's usage policy asks for a contact address on every request
GEOCODE_EMAIL=

# ---------------------------------------------------------------------
# REPORTS AND VIDEO — story reports and their rendering. Studio.
# ---------------------------------------------------------------------
# an ffmpeg binary to use instead of the bundled one (needed on hosts the bundle does not cover)
FFMPEG_PATH=
# the report fonts directory (default: the Studio's public/report-fonts)
REPORT_FONTS_DIR=
# days a finished report artifact is kept before the housekeeping sweep removes it (1–3650; default 90)
REPORT_ARTIFACT_RETENTION_DAYS=
# 1 to let a story report be narrated by the speech provider (capability report:narration)
REPORT_NARRATION_ENABLED=

# ---------------------------------------------------------------------
# APPLICATION LINKS — the three apps finding each other.
# ---------------------------------------------------------------------
# where the Interviews app is reachable; the Studio's hand-off link appears when set (e.g. http://localhost:3002)
NEXT_PUBLIC_INTERVIEWS_URL=
# the runtime's server-to-server address for the Studio (alerts, notifications); falls back to STUDIO_PUBLIC_URL
STUDIO_INTERNAL_URL=
# development only: where the runtime's sandbox forwards group sessions when it has no database (default http://localhost:3000)
STUDIO_SANDBOX_URL=

# ---------------------------------------------------------------------
# SWITCHES
# ---------------------------------------------------------------------
# the "anthropic-version" header sent to Anthropic-compatible endpoints (default 2023-06-01)
AI_ANTHROPIC_VERSION=
# "off" hides the import review screen and applies an import straight away (default: on)
IMPORT_REVIEW=
# 1 lets alert channels post to private / loopback addresses — only on an operator's own network
NOTIFY_ALLOW_PRIVATE_ENDPOINTS=
# "main" brings back the main-thread script runner for one release — a rollback hatch, read at build time
RUNTIME_LEGACY_SCRIPTS=

# Read by the platform, not set by you: NODE_ENV, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA,
# NEXT_DIST_DIR, TZ. Test-only: WRITE_OPERATOR_SNAPSHOT, WRITE_CORPUS_SNAPSHOT, RESCRIPT_NL_DEBUG.
