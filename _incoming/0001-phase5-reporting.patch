+      }
+      case "method": {
+        frame(s, slide.title, "Method");
+        const rows = slide.items.map((it) => ({ label: it.label, value: it.value }));
+        addTable(s, { id: "method", title: "Method", columns: [{ key: "label", label: "" }, { key: "value", label: "" }], rows }, theme, { x: g, y: 1.2, w: W - 2 * g }, 12, 10);
