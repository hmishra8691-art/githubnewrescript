@@ -0,0 +1,81 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { aiConfigured, aiProviderName, completeJson } from "@rescript/ai";
+import {
+  ASK_INSTRUCTIONS, askBrief, checkChartChoice, definitionFor, itemsFromModel, normalizeReportDefinition, proposeFromText, surveyKnownNames, validateAskOp, variableMetadata,
+  type AnalysisDefinition, type AnalysisResult, type AskContext, type AskItem, type AskOp, type AskProposal, type ChartSpec, type UndoRecord, type DatasetSpec, type ReportDefinition,
+} from "@rescript/analytics";
+import type { SurveyDefinition } from "@rescript/schema";
+import type { AuthedUser } from "@/lib/guard";
+import { billingProjectFor, meteredAi } from "@/lib/metering";
+import { compute, type LoadedContext } from "@/lib/analytics";
+export { applyOps, undoRecords, type AppliedItem, type Undone } from "@/lib/analyticsAskApply";
+
+/**
+ * SERVER SIDE OF INTELLIGENT MODE FOR ANALYTICS.
+ *
+ *   propose  — read-only. Words → reviewable items. Nothing is written.
+ *   apply    — each item is validated AGAIN against the live survey, saved
+ *              analyses and results, then executed; every executed item says
+ *              what it did and how to undo it. A blocked item is reported and
+ *              left alone — one failure never stops the others.
+ *   undo     — reverses what apply recorded, unless the thing was changed since.
+ *
+ * A report is never created from here: it goes through the report builder's
+ * review step (included / left out / why), which is the one place that draft is
+ * shown. No operation carries a statistic — the model, when there is one, only
+ * picks operations from the closed vocabulary.
+ */
+const MAX_ANALYSES = 80;
+
+export const datasetFrom = (raw: unknown): DatasetSpec => {
+  const d = (raw && typeof raw === "object" ? raw : {}) as Record<string, unknown>;
+  return { environment: d.environment === "TEST" || d.environment === "ALL" ? d.environment : "LIVE", dataset: d.dataset === "clean" ? "clean" : "all" } as DatasetSpec;
+};
+
+export async function askContext(db: SupabaseClient, surveyId: string, loaded: LoadedContext, dataset: DatasetSpec, opts: { results: boolean }): Promise<AskContext> {
+  const [{ data: a }, { data: r }] = await Promise.all([
+    db.from("analytics_analyses").select("id, name, definition").eq("survey_id", surveyId).is("deleted_at", null).order("position", { ascending: true, nullsFirst: false }).limit(MAX_ANALYSES),
+    db.from("analytics_reports").select("id, name, definition, kind").eq("survey_id", surveyId).is("deleted_at", null).eq("kind", "report").limit(40),
+  ]);
+  const analyses = ((a ?? []) as { id: string; name: string; definition: AnalysisDefinition }[]).map((x) => ({ id: x.id, name: x.name, definition: { ...x.definition, id: x.id, name: x.name } as AnalysisDefinition }));
+  const reports = ((r ?? []) as { id: string; name: string; definition: ReportDefinition }[]).map((x) => ({ id: x.id, name: x.name, definition: x.definition }));
+  const results: Record<string, AnalysisResult | undefined> = {};
+  if (opts.results) {
+    /* only the analyses a chart block reads — computing all of them to answer a question about charts would be waste */
+    const wanted = new Set<string>();
+    for (const rep of reports) for (const b of rep.definition.blocks ?? []) if (b.type === "chart" && b.analysisId) wanted.add(b.analysisId);
+    for (const an of analyses) if (wanted.has(an.id)) {
+      try { results[an.id] = (await compute(db, surveyId, loaded, an.definition)) as AnalysisResult; } catch (e) { console.error(`[analytics] ask: analysis ${an.id} failed:`, e); }
+    }
+  }
+  const vmeta = variableMetadata(loaded.def as SurveyDefinition);
+  return { variables: vmeta, known: surveyKnownNames(loaded.def as SurveyDefinition, vmeta), analyses, reports, results, dataset };
+}
+
+export type ModelAsk = "not_asked" | "no_model" | "nothing" | "used";
+
+/** Rules first; a model only for a request the rules could not read at all, answering in the same closed vocabulary. */
+export async function propose(db: SupabaseClient, user: AuthedUser | null, surveyId: string, loaded: LoadedContext, request: string, dataset: DatasetSpec, opts: { model: boolean; fake?: unknown }): Promise<AskProposal & { model: { status: ModelAsk; detail: string } }> {
+  const ctx = await askContext(db, surveyId, loaded, dataset, { results: true });
+  const p = proposeFromText(request, ctx);
+  if (!opts.model || !p.unread.length) return { ...p, model: { status: "not_asked", detail: "" } };
+  if (!aiConfigured()) return { ...p, model: { status: "no_model", detail: "No AI model is configured, so only the parts that could be read by rules were proposed." } };
+  let raw: unknown = aiProviderName() === "fake" && opts.fake && typeof opts.fake === "object" ? opts.fake : null;
+  if (!raw) {
+    const billing = await billingProjectFor(user, surveyId, "analytics.edit");
+    if ("response" in billing) return { ...p, model: { status: "nothing", detail: "The workspace could not be charged for the model call." } };
+    const prompt = `${ASK_INSTRUCTIONS}\n\n${askBrief(p.unread.join("\n"), ctx.variables)}`;
+    const m = await meteredAi(billing.meter, billing.ctx, "AI_REQUEST", { estimateText: prompt, maxTokens: 800, operation: "analytics_ask" }, () => completeJson("You translate analysis requests into a closed set of operations. Answer with JSON only.", prompt, 800, { timeoutMs: 30_000 })).catch(() => null);
+    raw = m && m.ok ? m.value : null;
+  }
+  if (!raw) return { ...p, model: { status: "nothing", detail: "The model gave nothing usable for the parts that could not be read." } };
+  const { items, rejected } = itemsFromModel(raw, ctx);
+  const taken = new Set(p.items.map((i) => JSON.stringify({ ...i.op, name: undefined })));
+  const fresh = items.filter((i) => !taken.has(JSON.stringify({ ...i.op, name: undefined })));
+  return {
+    ...p, items: [...p.items, ...fresh.map((i) => ({ ...i, why: `Suggested by the model: ${i.why}` }))],
+    unread: fresh.length ? [] : p.unread,
+    notes: [...p.notes, ...(rejected.length ? [`The model suggested ${rejected.length} operation${rejected.length === 1 ? "" : "s"} that were dropped: ${rejected.join("; ")}.`] : [])],
+    model: { status: fresh.length ? "used" : "nothing", detail: fresh.length ? `${fresh.length} item${fresh.length === 1 ? "" : "s"} from the model — each checked like the rest.` : "The model had nothing to add." },
+  };
+}
diff --git a/apps/studio/lib/analyticsAskApply.test.ts b/apps/studio/lib/analyticsAskApply.test.ts
new file mode 100644
index 0000000..36f8fd1
--- /dev/null
+++ b/apps/studio/lib/analyticsAskApply.test.ts
@@ -0,0 +1,138 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { buildDataset, runAnalysis, variableMetadata, surveyKnownNames, type AnalysisDefinition, type AskContext, type AskOp, type ReportDefinition } from "@rescript/analytics";
+import { applyOps, undoRecords } from "./analyticsAskApply.ts";
+// the analytics fixture is test support inside the package, not part of its public surface
+// @ts-ignore
+import { def, synthRows } from "../../../packages/analytics/dist/analyses/fixture.js";
+
+/* a small in-memory stand-in for the database client: the chain the apply code uses, with real filter semantics */
+type Row = Record<string, any>;
+function memoryDb(seed: Record<string, Row[]>) {
+  const tables: Record<string, Row[]> = JSON.parse(JSON.stringify(seed));
+  let n = 0;
+  class Q {
+    mode: "select" | "insert" | "update" = "select"; payload: any; filters: ((r: Row) => boolean)[] = []; single_ = false; maybe = false;
+    table: string;
+    constructor(table: string) { this.table = table; }
+    select() { return this; }
+    insert(row: Row) { this.mode = "insert"; this.payload = row; return this; }
+    update(p: Row) { this.mode = "update"; this.payload = p; return this; }
+    eq(c: string, v: unknown) { this.filters.push((r) => r[c] === v); return this; }
+    is(c: string, v: unknown) { this.filters.push((r) => (r[c] ?? null) === v); return this; }
+    in(c: string, vs: unknown[]) { this.filters.push((r) => vs.includes(r[c])); return this; }
+    single() { this.single_ = true; return this; }
+    maybeSingle() { this.maybe = true; return this; }
+    run() {
+      const t = (tables[this.table] ??= []);
+      let rows: Row[];
+      if (this.mode === "insert") { const row = { id: `00000000-0000-4000-8000-${String(++n).padStart(12, "0")}`, deleted_at: null, ...this.payload }; t.push(row); rows = [row]; }
+      else { rows = t.filter((r) => this.filters.every((f) => f(r))); if (this.mode === "update") for (const r of rows) Object.assign(r, this.payload); }
+      if (this.single_) return rows.length ? { data: { ...rows[0] }, error: null } : { data: null, error: { message: "no rows" } };
+      if (this.maybe) return { data: rows[0] ? { ...rows[0] } : null, error: null };
+      return { data: rows.map((r) => ({ ...r })), error: null };
+    }
+    then(ok?: (v: any) => unknown, no?: (e: any) => unknown) { return Promise.resolve(this.run()).then(ok, no); }
+  }
+  return { tables, from: (t: string) => new Q(t) } as unknown as { tables: Record<string, Row[]>; from: (t: string) => any };
+}
+
+const spec = { environment: "LIVE" as const, dataset: "all" as const };
+const ds = buildDataset(def, synthRows(), { spec });
+const vars = variableMetadata(def);
+const SURVEY = "11111111-1111-4111-8111-111111111111", OTHER = "22222222-2222-4222-8222-222222222222";
+const A = (n: number) => `a000000${n}-0000-4000-8000-000000000000`;
+const analysisRow = (i: number, name: string, definition: Partial<AnalysisDefinition>, survey = SURVEY): Row => ({ id: A(i), survey_id: survey, name, deleted_at: null, version: 1, definition: { name, dataset: spec, ...definition } });
+const R1 = "bbbbbbbb-0000-4000-8000-000000000001";
+
+const contextFor = (db: ReturnType<typeof memoryDb>) => async (needResults: boolean): Promise<AskContext> => {
+  const analyses = db.tables.analytics_analyses.filter((r) => r.survey_id === SURVEY && !r.deleted_at).map((r) => ({ id: r.id, name: r.name, definition: { ...r.definition, id: r.id, name: r.name } as AnalysisDefinition }));
+  const reports = (db.tables.analytics_reports ?? []).filter((r) => r.survey_id === SURVEY && !r.deleted_at).map((r) => ({ id: r.id, name: r.name, definition: r.definition as ReportDefinition }));
+  const results = needResults ? Object.fromEntries(analyses.map((a) => [a.id, runAnalysis(a.definition, ds)])) : {};
+  return { variables: vars, known: surveyKnownNames(def as never, vars), analyses, reports, results, dataset: spec };
+};
+/* undo records travel through the browser as JSON; a test that shares objects with the stored row would hide edits made in between */
+const wire = <T,>(x: T): T => JSON.parse(JSON.stringify(x));
+const crosstab = (name: string, rows: string[], columns: string[]): AskOp => ({ op: "add_crosstab", name, rows, columns });
+const apply = (db: ReturnType<typeof memoryDb>, ops: AskOp[], request = "r") => applyOps(db as never, SURVEY, "1.0", "u1", ops, spec, request, contextFor(db));
+
+const seed = () => memoryDb({
+  analytics_analyses: [analysisRow(1, "Satisfaction", { kind: "descriptive", variables: ["SAT"] }), analysisRow(2, "Satisfaction (2)", { kind: "descriptive", variables: ["SAT"] }), analysisRow(3, "Brands considered", { kind: "descriptive", variables: ["CONSIDER"] }), analysisRow(9, "Elsewhere", { kind: "descriptive", variables: ["SAT"] }, OTHER)],
+  analytics_analysis_versions: [], analytics_charts: [],
+  analytics_reports: [{ id: R1, survey_id: SURVEY, name: "Report", deleted_at: null, definition: { title: "Report", mode: "live", blocks: [{ id: "c1", type: "chart", title: "Brands", analysisId: A(3), chart: { type: "pie", options: {} } }] } }],
+});
+
+test("creating: the analysis, its first version and where it came from are saved; the same item twice in one batch lands once", async () => {
+  const db = seed();
+  const out = await apply(db, [crosstab("Satisfaction by gender", ["SAT"], ["GENDER"]), crosstab("Satisfaction by gender again", ["SAT"], ["GENDER"])], "crosstab of satisfaction by gender");
+  assert.deepEqual(out.map((o) => o.status), ["done", "blocked"]);
+  assert.match(out[1].message, /already have “Satisfaction by gender”/);
+  const row = db.tables.analytics_analyses.find((r) => r.name === "Satisfaction by gender")!;
+  assert.equal(row.kind, "crosstab"); assert.equal(row.survey_id, SURVEY); assert.equal(row.created_by, "u1");
+  assert.equal(row.definition.options.requested, "crosstab of satisfaction by gender");
+  assert.deepEqual(row.definition.rows, ["SAT"]);
+  assert.equal(db.tables.analytics_analysis_versions.length, 1);
+  assert.equal(db.tables.analytics_analysis_versions[0].analysis_id, row.id);
+  assert.equal(db.tables.analytics_analyses.length, 5, "exactly one analysis was added");
+  assert.deepEqual(out[0].undo, { kind: "created_analysis", id: row.id });
+});
+
+test("a blocked item does not stop the ones after it, and an unknown variable is never saved", async () => {
+  const db = seed();
+  const out = await apply(db, [crosstab("Bad", ["NOPE"], ["GENDER"]), crosstab("Good", ["SAT"], ["REGION"])]);
+  assert.deepEqual(out.map((o) => o.status), ["blocked", "done"]);
+  assert.match(out[0].message, /NOPE/);
+  assert.equal(db.tables.analytics_analyses.filter((r) => r.name === "Bad").length, 0);
+});
+
+test("removing is a soft delete with its charts; undo brings both back, and only the charts it took", async () => {
+  const db = seed();
+  db.tables.analytics_charts.push({ id: "ch1", survey_id: SURVEY, analysis_id: A(2), deleted_at: null }, { id: "ch2", survey_id: SURVEY, analysis_id: A(2), deleted_at: "2026-01-01" });
+  const out = await apply(db, [{ op: "remove_analysis", name: "Satisfaction (2)", analysisId: A(2), keptId: A(1) }]);
+  assert.equal(out[0].status, "done");
+  assert.ok(db.tables.analytics_analyses.find((r) => r.id === A(2))!.deleted_at);
+  assert.ok(db.tables.analytics_charts.find((r) => r.id === "ch1")!.deleted_at);
+  const u = await undoRecords(db as never, SURVEY, "u1", [out[0].undo!]);
+  assert.equal(u[0].status, "undone");
+  assert.equal(db.tables.analytics_analyses.find((r) => r.id === A(2))!.deleted_at, null);
+  assert.equal(db.tables.analytics_charts.find((r) => r.id === "ch1")!.deleted_at, null);
+  assert.equal(db.tables.analytics_charts.find((r) => r.id === "ch2")!.deleted_at, "2026-01-01", "a chart that was already gone stays gone");
+});
+
+test("an analysis a report uses is not removed; another survey's analysis cannot be reached", async () => {
+  const db = seed();
+  const used = await apply(db, [{ op: "remove_analysis", name: "Brands", analysisId: A(3) }]);
+  assert.equal(used[0].status, "blocked"); assert.match(used[0].message, /used by “Report”/);
+  assert.equal(db.tables.analytics_analyses.find((r) => r.id === A(3))!.deleted_at, null);
+  const foreign = await apply(db, [{ op: "remove_analysis", name: "x", analysisId: A(9) }]);
+  assert.equal(foreign[0].status, "blocked");
+  assert.equal(db.tables.analytics_analyses.find((r) => r.id === A(9))!.deleted_at, null, "the other survey's analysis is untouched");
+  await undoRecords(db as never, SURVEY, "u1", [{ kind: "created_analysis", id: A(9) }]);
+  assert.equal(db.tables.analytics_analyses.find((r) => r.id === A(9))!.deleted_at, null, "undo is scoped to this survey too");
+});
+
+test("a chart change is saved on the report block and undone; a chart edited since is left alone", async () => {
+  const db = seed();
+  const op: AskOp = { op: "set_chart", name: "Brands", reportId: R1, blockId: "c1", analysisId: A(3), chart: "bar_horizontal", from: "pie" };
+  const out = wire(await apply(db, [op]));
+  assert.equal(out[0].status, "done");
+  const block = () => (db.tables.analytics_reports[0].definition.blocks as any[]).find((b) => b.id === "c1");
+  assert.equal(block().chart.type, "bar_horizontal");
+  const u = await undoRecords(db as never, SURVEY, "u1", [out[0].undo!]);
+  assert.equal(u[0].status, "undone"); assert.equal(block().chart.type, "pie");
+  const again = wire(await apply(db, [op]));
+  block().chart.type = "lollipop"; // someone changed it after the request did
+  const skipped = await undoRecords(db as never, SURVEY, "u1", [again[0].undo!]);
+  assert.equal(skipped[0].status, "skipped"); assert.match(skipped[0].message, /changed again/);
+  assert.equal(block().chart.type, "lollipop");
+});
+
+test("a chart the result cannot be drawn as is blocked and the report is unchanged; a report is never created from here", async () => {
+  const db = seed();
+  const before = JSON.stringify(db.tables.analytics_reports[0].definition);
+  const out = await apply(db, [{ op: "set_chart", name: "x", reportId: R1, blockId: "c1", analysisId: A(3), chart: "heatmap" }, { op: "build_report", name: "R", story: false, brief: { objective: "x", audience: "client", tone: "plain", keyQuestions: [] } }]);
+  assert.deepEqual(out.map((o) => o.status), ["blocked", "blocked"]);
+  assert.match(out[1].message, /report builder/);
+  assert.equal(JSON.stringify(db.tables.analytics_reports[0].definition), before);
+  assert.equal(db.tables.analytics_reports.length, 1);
+});
diff --git a/apps/studio/lib/analyticsAskApply.ts b/apps/studio/lib/analyticsAskApply.ts
new file mode 100644
index 0000000..8ee48a2
--- /dev/null
+++ b/apps/studio/lib/analyticsAskApply.ts
@@ -0,0 +1,92 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { definitionFor, normalizeReportDefinition, validateAskOp, type AskContext, type AskOp, type ChartSpec, type DatasetSpec, type ReportDefinition, type UndoRecord } from "@rescript/analytics";
+
+/**
+ * APPLYING AND UNDOING WHAT INTELLIGENT MODE PROPOSED — the writes.
+ *
+ * Kept apart from the proposal code so it depends on nothing but the database
+ * client and the pure analytics package, which is what lets its tests run the
+ * real statements against an in-memory database. Each item is validated again
+ * against the context as it is NOW (the proposal may be minutes old and the
+ * browser's copy of it is not trusted), executed on its own, and reports what
+ * it did and how to reverse it.
+ */
+/* ------------------------------------------------------------------ apply / undo */
+
+export interface AppliedItem { index: number; name: string; status: "done" | "blocked" | "failed"; message: string; undo?: UndoRecord; createdId?: string }
+
+const now = () => new Date().toISOString();
+
+export async function applyOps(db: SupabaseClient, surveyId: string, surveyVersion: string | null, userId: string | null, ops: readonly AskOp[], dataset: DatasetSpec, request: string, contextFor: (needResults: boolean) => Promise<AskContext>): Promise<AppliedItem[]> {
+  const out: AppliedItem[] = [];
+  /* one context for the whole batch, rebuilt after every write so a later item sees what an earlier one did (two items for the same cross-tab cannot both land) */
+  for (let index = 0; index < ops.length; index++) {
+    const op = ops[index];
+    const name = op.name || op.op;
+    const ctx = await contextFor(op.op === "set_chart");
+    if (op.op === "build_report") { out.push({ index, name, status: "blocked", message: "A report is reviewed in the report builder before it is created — open it from this item." }); continue; }
+    const v = validateAskOp(op, ctx);
+    if (v.blocked.length) { out.push({ index, name, status: "blocked", message: v.blocked.join(" ") }); continue; }
+    try {
+      if (op.op === "add_crosstab" || op.op === "add_test" || op.op === "add_descriptive") {
+        const def = definitionFor(op, dataset, request)!;
+        const row = { survey_id: surveyId, name: op.name.slice(0, 160), kind: def.kind, definition: { ...def, name: op.name.slice(0, 160), surveyVersion: surveyVersion ?? undefined }, version: 1, folder: null, tags: [], created_by: userId, updated_by: userId };
+        const { data, error } = await db.from("analytics_analyses").insert(row).select("id, definition").single();
+        if (error || !data) { out.push({ index, name, status: "failed", message: error?.message ?? "The analysis could not be saved." }); continue; }
+        await db.from("analytics_analysis_versions").insert({ analysis_id: data.id, survey_id: surveyId, version: 1, definition: data.definition, summary: "Created from a request", created_by: userId });
+        out.push({ index, name, status: "done", message: "Created.", createdId: String(data.id), undo: { kind: "created_analysis", id: String(data.id) } });
+      } else if (op.op === "remove_analysis") {
+        const { data: charts } = await db.from("analytics_charts").select("id").eq("analysis_id", op.analysisId).is("deleted_at", null);
+        const { error } = await db.from("analytics_analyses").update({ deleted_at: now(), updated_by: userId }).eq("id", op.analysisId).eq("survey_id", surveyId).is("deleted_at", null);
+        if (error) { out.push({ index, name, status: "failed", message: error.message }); continue; }
+        const chartIds = (charts ?? []).map((c) => String(c.id));
+        if (chartIds.length) await db.from("analytics_charts").update({ deleted_at: now() }).eq("survey_id", surveyId).in("id", chartIds);
+        out.push({ index, name, status: "done", message: "Removed (it can be restored with Undo).", undo: { kind: "removed_analysis", id: op.analysisId, chartIds } });
+      } else if (op.op === "set_chart") {
+        const { data: rep } = await db.from("analytics_reports").select("definition").eq("id", op.reportId).eq("survey_id", surveyId).is("deleted_at", null).maybeSingle();
+        const def = rep?.definition as ReportDefinition | undefined;
+        const block = def?.blocks?.find((b) => b.id === op.blockId);
+        if (!def || !block || block.type !== "chart") { out.push({ index, name, status: "blocked", message: "That chart is no longer in the report." }); continue; }
+        const before = block.chart as ChartSpec;
+        const after: ChartSpec = { ...before, type: op.chart };
+        const next = normalizeReportDefinition({ ...def, blocks: def.blocks!.map((b) => (b.id === op.blockId && b.type === "chart" ? { ...b, chart: after } : b)) } as never);
+        const { error } = await db.from("analytics_reports").update({ definition: next, updated_by: userId }).eq("id", op.reportId).eq("survey_id", surveyId);
+        if (error) { out.push({ index, name, status: "failed", message: error.message }); continue; }
+        out.push({ index, name, status: "done", message: `Now ${op.chart.replace(/_/g, " ")}.`, undo: { kind: "chart_changed", reportId: op.reportId, blockId: op.blockId, before, after } });
+      }
+    } catch (e) { console.error("[analytics] ask apply failed:", e); out.push({ index, name, status: "failed", message: (e as Error)?.message ?? "It could not be applied." }); }
+  }
+  return out;
+}
+
+export interface Undone { name: string; status: "undone" | "skipped"; message: string }
+
+export async function undoRecords(db: SupabaseClient, surveyId: string, userId: string | null, records: readonly UndoRecord[]): Promise<Undone[]> {
+  const out: Undone[] = [];
+  for (const r of records) {
+    try {
+      if (r.kind === "created_analysis") {
+        const { error } = await db.from("analytics_analyses").update({ deleted_at: now(), updated_by: userId }).eq("id", r.id).eq("survey_id", surveyId).is("deleted_at", null);
+        await db.from("analytics_charts").update({ deleted_at: now() }).eq("survey_id", surveyId).eq("analysis_id", r.id).is("deleted_at", null);
+        out.push({ name: r.id, status: error ? "skipped" : "undone", message: error ? error.message : "Analysis removed again." });
+      } else if (r.kind === "removed_analysis") {
+        const { error } = await db.from("analytics_analyses").update({ deleted_at: null, updated_by: userId }).eq("id", r.id).eq("survey_id", surveyId);
+        if (!error && r.chartIds.length) await db.from("analytics_charts").update({ deleted_at: null }).eq("survey_id", surveyId).in("id", r.chartIds);
+        out.push({ name: r.id, status: error ? "skipped" : "undone", message: error ? error.message : "Analysis restored." });
+      } else {
+        const { data: rep } = await db.from("analytics_reports").select("definition").eq("id", r.reportId).eq("survey_id", surveyId).is("deleted_at", null).maybeSingle();
+        const def = rep?.definition as ReportDefinition | undefined;
+        const block = def?.blocks?.find((b) => b.id === r.blockId);
+        if (!def || !block || block.type !== "chart") { out.push({ name: r.blockId, status: "skipped", message: "That chart is no longer in the report." }); continue; }
+        /* someone changed this chart after the request did — their choice stands */
+        if (block.chart?.type !== r.after.type) { out.push({ name: r.blockId, status: "skipped", message: "The chart was changed again since, so it was left as it is." }); continue; }
+        const next = normalizeReportDefinition({ ...def, blocks: def.blocks!.map((b) => (b.id === r.blockId && b.type === "chart" ? { ...b, chart: r.before } : b)) } as never);
+        const { error } = await db.from("analytics_reports").update({ definition: next, updated_by: userId }).eq("id", r.reportId).eq("survey_id", surveyId);
+        out.push({ name: r.blockId, status: error ? "skipped" : "undone", message: error ? error.message : "Chart restored." });
+      }
+    } catch (e) { out.push({ name: "item", status: "skipped", message: (e as Error)?.message ?? "It could not be undone." }); }
+  }
+  return out;
+}
+
+export type { UndoRecord };
diff --git a/docs/DATA-ANALYTICS-AUDIT-2026-10-12.md b/docs/DATA-ANALYTICS-AUDIT-2026-10-12.md
