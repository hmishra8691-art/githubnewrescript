@@ -0,0 +1,27 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { parseBrief } from "./analyticsBrief.ts";
+
+const id = "11111111-1111-4111-8111-111111111111";
+
+test("a brief is bounded and unknown fields are dropped", () => {
+  const b = parseBrief({ objective: "x".repeat(5000), audience: "board", tone: "angry", keyQuestions: ["a", "", "  b  ", ...Array(20).fill("q")], analysisIds: [id, "not-a-uuid", 7], maxItems: 9999, includeTests: false, includeCrosstabs: true, title: "T", client: "C", evil: "<script>" });
+  assert.equal(b.objective.length, 1000);
+  assert.equal(b.audience, "client", "unknown audience falls back");
+  assert.equal(b.tone, "plain", "unknown tone falls back");
+  assert.equal(b.keyQuestions.length, 10);
+  assert.deepEqual(b.keyQuestions.slice(0, 2), ["a", "b"]);
+  assert.deepEqual(b.analysisIds, [id]);
+  assert.equal(b.maxItems, 40);
+  assert.equal(b.includeTests, false);
+  assert.equal("includeCrosstabs" in b, false, "true is the default and is not stored");
+  assert.ok(!("evil" in b));
+});
+
+test("key questions may arrive as one multi-line string, and garbage becomes an empty brief", () => {
+  assert.deepEqual(parseBrief({ keyQuestions: "first\n\nsecond" }).keyQuestions, ["first", "second"]);
+  const empty = parseBrief(null);
+  assert.equal(empty.objective, ""); assert.deepEqual(empty.keyQuestions, []);
+  assert.equal(parseBrief({ maxItems: -3 }).maxItems, 1);
+  assert.equal(parseBrief({ maxItems: "5" }).maxItems, undefined);
+});
diff --git a/apps/studio/lib/analyticsBrief.ts b/apps/studio/lib/analyticsBrief.ts
new file mode 100644
index 0000000..a17a325
--- /dev/null
+++ b/apps/studio/lib/analyticsBrief.ts
@@ -0,0 +1,23 @@
+import type { ReportBrief } from "@rescript/analytics";
+
+const MAX_ANALYSES = 60;
+/* ------------------------------------------------------------ request parsing */
+
+const isUuid = (s: unknown): s is string => typeof s === "string" && /^[0-9a-f-]{36}$/i.test(s);
+const str = (v: unknown, max: number): string => (typeof v === "string" ? v.trim().slice(0, max) : "");
+
+/** A brief from a request body: every field checked and bounded, unknown fields dropped. */
+export function parseBrief(raw: unknown): ReportBrief {
+  const b = (raw && typeof raw === "object" ? raw : {}) as Record<string, unknown>;
+  const audience = b.audience === "executive" || b.audience === "researcher" ? b.audience : "client";
+  const tone = b.tone === "formal" || b.tone === "concise" ? b.tone : "plain";
+  const keyQuestions = (Array.isArray(b.keyQuestions) ? b.keyQuestions : typeof b.keyQuestions === "string" ? b.keyQuestions.split(/\r?\n/) : []).map((q) => str(q, 300)).filter(Boolean).slice(0, 10);
+  const analysisIds = Array.isArray(b.analysisIds) ? b.analysisIds.filter(isUuid).slice(0, MAX_ANALYSES) : undefined;
+  const maxItems = typeof b.maxItems === "number" && Number.isFinite(b.maxItems) ? Math.max(1, Math.min(40, Math.round(b.maxItems))) : undefined;
+  return {
+    objective: str(b.objective, 1000), audience, tone, keyQuestions,
+    ...(analysisIds?.length ? { analysisIds } : {}), ...(maxItems ? { maxItems } : {}),
+    ...(b.includeTests === false ? { includeTests: false } : {}), ...(b.includeCrosstabs === false ? { includeCrosstabs: false } : {}),
+    ...(str(b.title, 120) ? { title: str(b.title, 120) } : {}), ...(str(b.client, 120) ? { client: str(b.client, 120) } : {}),
+  };
+}
