+      case "block_complete": hold(complete && !!i.blockId && (b.target.blockId ?? "") === i.blockId); break;
+      case "appear": case "page_enter": if (opened && onPage) out.fire.push(b); break;
+      default: break;
+    }
+  }
+  return out;
+}
