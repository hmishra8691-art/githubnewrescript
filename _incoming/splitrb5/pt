+  const out = await apply(db, [{ op: "set_chart", name: "x", reportId: R1, blockId: "c1", analysisId: A(3), chart: "heatmap" }, { op: "build_report", name: "R", story: false, brief: { objective: "x", audience: "client", tone: "plain", keyQuestions: [] } }]);
