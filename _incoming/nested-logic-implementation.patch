+    if (ch === "(") depth++;
+    else if (ch === ")") depth = Math.max(0, depth - 1);
+    else if (depth === 0 && /\s/.test(ch)) {
+      const m = re.exec(t.slice(i));
+      if (m) { parts.push(t.slice(last, i).trim()); i += m[0].length - 1; last = i + 1; }
+    }
+  }
+  parts.push(t.slice(last).trim());
+  return parts.filter(Boolean);
+}
