+    /* 3. the charts — one per planned item, typed as the run recommends */
+    const chartsNow = (await loadRows(db, surveyId)).charts;
+    let chartCount = 0;
+    for (const c of planChartSync(items, (id) => idFor.get(id), chartsNow, runItems)) {
