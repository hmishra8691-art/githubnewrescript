+  };
+  const Pick = ({ label, value, onChange, multi, testid }: { label: string; value: string[] | string; onChange: (v: string[] | string) => void; multi?: boolean; testid: string }) => (
+    <label className="ax-field ap-field"><span>{label}</span>
+      {multi ? (
