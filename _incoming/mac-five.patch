+const SECTION_WORDS: [RegExp, Scene["kind"][]][] = [
+  [/method(ology)?|how (it|the study) was done/, ["method"]], [/sample|who took part|respondents?|profile/, ["sample"]], [/objective|research question/, ["objective"]],
