+    }
+    const chartSpecs = new Map<string, ChartSpec>();
+    for (const c of (await loadRows(db, surveyId)).charts) { const id = c.spec?.id; if (typeof id === "string" && id.startsWith("plan:")) chartSpecs.set(id.slice(5), c.spec); }
