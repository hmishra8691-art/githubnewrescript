diff --git a/scripts/lib/fakeSupabase.mjs b/scripts/lib/fakeSupabase.mjs
new file mode 100644
index 0000000..4a858af
--- /dev/null
+++ b/scripts/lib/fakeSupabase.mjs
@@ -0,0 +1,78 @@
+/**
+ * AN IN-MEMORY SUPABASE for tests: the query chains the Studio's analytics
+ * service uses (select / insert / update with eq, is, gte, lt, in, order,
+ * limit, single, maybeSingle, head counts) over plain arrays, and the one RPC
+ * the plan editor calls (`rescript_save_draft`, with its revision guard).
+ * Timestamps are monotonic the way Postgres's microseconds are, so two rows
+ * written in one millisecond still order. Used by the studio's
+ * analysisPlanCore unit test and by the analysis-plan browser test, where the
+ * REAL service runs over it inside the test process.
+ */
+let seq = 0;
+export const uuid = () => `00000000-0000-4000-8000-${(++seq).toString(16).padStart(12, "0")}`;
+let tick = Date.now();
+export const stamp = () => new Date(++tick).toISOString();
+
+class Query {
+  constructor(db, table) { this.db = db; this.table = table; this.op = "select"; this.filters = []; this.head = false; this.wantCount = false; this.orderBy = null; this.limitN = null; this.mode = "many"; this.payload = null; }
+  select(_cols, opts) { if (opts?.head) this.head = true; if (opts?.count) this.wantCount = true; return this; }
+  insert(row) { this.op = "insert"; this.payload = row; return this; }
+  update(patch) { this.op = "update"; this.payload = patch; return this; }
+  eq(col, v) { this.filters.push((r) => r[col] === v); return this; }
+  is(col, v) { this.filters.push((r) => (v === null ? r[col] == null : r[col] === v)); return this; }
+  gte(col, v) { this.filters.push((r) => String(r[col]) >= v); return this; }
+  lt(col, v) { this.filters.push((r) => String(r[col]) < v); return this; }
+  in(col, vs) { this.filters.push((r) => vs.includes(r[col])); return this; }
+  or(expr) {
+    /* `survey_id.eq.X,customer_id.eq.Y` — the one shape the analytics route writes */
+    const alts = expr.split(",").map((part) => { const [col, , ...rest] = part.split("."); return { col, v: rest.join(".") }; });
+    this.filters.push((r) => alts.some((a) => String(r[a.col]) === a.v));
+    return this;
+  }
+  order(col, opts) { this.orderBy = { col, asc: opts?.ascending !== false }; return this; }
+  limit(n) { this.limitN = n; return this; }
+  single() { this.mode = "single"; return this; }
+  maybeSingle() { this.mode = "maybe"; return this; }
+  then(resolve, reject) { return Promise.resolve().then(() => this.run()).then(resolve, reject); }
+  run() {
+    const rows = this.db.tables[this.table];
+    if (!rows) return { data: null, error: { message: `relation "public.${this.table}" does not exist` } };
+    if (this.op === "insert") {
+      const row = { id: uuid(), created_at: stamp(), updated_at: stamp(), ...this.payload };
+      if (this.table === "analytics_plan_applies" && !this.payload?.started_at) row.started_at = stamp();
+      rows.push(row);
+      this.db.log.push({ op: "insert", table: this.table, row });
+      return { data: this.mode === "many" ? [row] : row, error: null };
+    }
+    let hit = rows.filter((r) => this.filters.every((f) => f(r)));
+    if (this.op === "update") {
+      for (const r of hit) Object.assign(r, this.payload, { updated_at: stamp() });
+      this.db.log.push({ op: "update", table: this.table, n: hit.length });
+      return { data: this.mode === "many" ? hit : hit[0] ?? null, error: this.mode === "single" && !hit[0] ? { message: "no row" } : null };
+    }
+    if (this.orderBy) { const { col, asc } = this.orderBy; hit = [...hit].sort((a, b) => (String(a[col]) < String(b[col]) ? -1 : String(a[col]) > String(b[col]) ? 1 : 0) * (asc ? 1 : -1)); }
+    if (this.limitN != null) hit = hit.slice(0, this.limitN);
+    if (this.head) return { data: null, error: null, count: hit.length };
+    const data = hit.map((r) => structuredClone(r));
+    if (this.mode === "single") return data[0] ? { data: data[0], error: null } : { data: null, error: { message: "no row" } };
+    if (this.mode === "maybe") return { data: data[0] ?? null, error: null };
+    return { data, error: null, ...(this.wantCount ? { count: data.length } : {}) };
+  }
+}
+
+export class FakeDb {
+  constructor() {
+    /** @type {Record<string, Record<string, unknown>[]>} */
+    this.tables = { surveys: [], responses: [], analytics_analyses: [], analytics_analysis_versions: [], analytics_charts: [], analytics_segments: [], analytics_themes: [], analytics_reports: [], analytics_report_versions: [], analytics_shares: [], analytics_runs: [], analytics_plan_applies: [], audit_logs: [] };
+    /** @type {Record<string, unknown>[]} */
+    this.log = [];
+  }
+  from(table) { return new Query(this, table); }
+  async rpc(name, args) {
+    if (name !== "rescript_save_draft") return { data: null, error: { message: `function ${name} does not exist` } };
+    const s = this.tables.surveys.find((r) => r.id === args.p_survey_id);
+    if (!s || s.revision !== args.p_base_revision) return { data: [], error: null };
+    s.draft_definition = args.p_definition; s.revision = Number(s.revision) + 1; s.draft_updated_at = stamp();
+    return { data: [{ revision: s.revision, draft_updated_at: s.draft_updated_at }], error: null };
+  }
+}
diff --git a/supabase/migrations/0050_analysis_plan_applies.sql b/supabase/migrations/0050_analysis_plan_applies.sql
new file mode 100644
index 0000000..71280d4
--- /dev/null
+++ b/supabase/migrations/0050_analysis_plan_applies.sql
@@ -0,0 +1,48 @@
+-- 0050 — the analysis plan, applied (Data Analytics → Analysis plan).
+--
+-- "Apply analysis plan" takes the plan written in the survey definition
+-- (research.analysisPlan) and makes the Results outputs from it: the saved
+-- analyses (analytics_analyses, one per planned id), their charts
+-- (analytics_charts), the one findings report and the one dashboard it
+-- maintains (analytics_reports), and a run (analytics_runs) when responses
+-- exist. This table is the record of each apply: when, by whom, on which
+-- plan (its hash and updatedAt) and survey revision, what it did to every
+-- planned item, and what it produced — so the workspace can say whether the
+-- plan is saved, applied, or applied on a plan that has since changed,
+-- rather than guessing from the outputs.
+--
+-- A `running` row younger than two minutes is also the lock: a second apply
+-- of the same survey while one is in progress is refused, so two clicks
+-- never create the planned analyses twice.
+
+create table if not exists public.analytics_plan_applies (
+  id uuid primary key default gen_random_uuid(),
+  survey_id uuid not null references public.surveys(id) on delete cascade,
+  status text not null default 'running' check (status in ('running', 'applied', 'partial', 'no_data', 'failed')),
+  environment text not null default 'LIVE' check (environment in ('TEST', 'LIVE', 'ALL')),
+  dataset jsonb not null default '{}'::jsonb,
+  plan_hash text,
+  plan_updated_at text,
+  survey_revision bigint,
+  survey_version text,
+  run_id uuid references public.analytics_runs(id) on delete set null,
+  report_id uuid references public.analytics_reports(id) on delete set null,
+  dashboard_id uuid references public.analytics_reports(id) on delete set null,
+  summary jsonb not null default '{}'::jsonb,
+  error text,
+  started_at timestamptz not null default now(),
+  finished_at timestamptz,
+  created_by uuid
+);
+create index if not exists analytics_plan_applies_survey_idx on public.analytics_plan_applies (survey_id, started_at desc);
+
+alter table public.analytics_plan_applies enable row level security;
+drop policy if exists analytics_plan_applies_member_read on public.analytics_plan_applies;
+create policy analytics_plan_applies_member_read on public.analytics_plan_applies for select to authenticated
+  using (
+    public.rescript_project_role(auth.uid(), survey_id) is not null
+    or public.rescript_is_platform_admin(auth.uid())
+  );
+
+comment on table public.analytics_plan_applies is
+  'Every "Apply analysis plan" on a survey: the plan it applied (hash, updatedAt), what it did to each planned item, and the run, report and dashboard it produced or refreshed. Writes go through the Studio''s service role; members read.';
-- 
