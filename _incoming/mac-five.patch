+
+export interface LayoutContext {
+  design: DesignConfig;
+  measure: Measurer;
+  /** the canvas; PowerPoint is always 16:9 */
+  aspect: AspectRatio;
+  /** page number of this scene */
+  page: number;
+  /** total pages, for "n / N" */
+  pages: number;
