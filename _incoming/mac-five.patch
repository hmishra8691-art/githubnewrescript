+export function mix(a: string, b: string, t: number): string { const x = parseHex(a)!, y = parseHex(b)!; return toHex({ r: x.r + (y.r - x.r) * t, g: x.g + (y.g - x.g) * t, b: x.b + (y.b - x.b) * t }); }
