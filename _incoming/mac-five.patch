+const CHART_WORDS: [RegExp, StoryChartType][] = [
+  [/horizontal (bar|bars|column)/, "hbar"], [/(grouped|clustered|side[- ]by[- ]side) (bar|bars|column)/, "grouped_bar"], [/(100%|percent(age)?|stacked)/, "stacked_100"],
