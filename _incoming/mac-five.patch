+
+/** a number in a label counted from zero, keeping its decimals, prefix and suffix */
+function counted(text: string, p: number): string {
+  const m = /^(.*?)(-?[\d,]+(?:\.\d+)?)(.*)$/.exec(text);
+  if (!m || p >= 1) return text;
