+    { name: "Price perception", role: "independent", questions: ["Q6"] },
+    { name: "Switching", role: "dependent", questions: ["Q4"] },
+    { name: "Gender", role: "independent", questions: ["Q2"] },
+    { name: "Satisfaction", role: "dependent", questions: ["Q7"] },
