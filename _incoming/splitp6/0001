+export function modelSteps(wf: ResearchWorkflow): { id: WorkflowStepId; tier: ModelTier; estimateText: string; maxTokens: number; operation: string }[] {
+  return wf.steps.filter((s) => s.model).map((s) => ({ id: s.id, tier: s.tier, ...s.model! }));
+}
