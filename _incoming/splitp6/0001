+  const mark: Record<WorkflowStatus, string> = { done: "✓", ready: "→", needs_input: "?", model: "✱", blocked: "·" };
+  return [wf.summary, ...wf.steps.map((s) => `${mark[s.status]} ${s.title} — ${s.why}`)].join("\n");
