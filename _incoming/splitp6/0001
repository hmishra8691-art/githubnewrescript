+    assert.equal(aiModelName("small"), "big-model");
+  });
+  await withEnv({ AI_MODEL_SMALL: "  " }, async () => {
+    assert.equal(aiModelName("small"), "gpt-4o-mini");
+    assert.equal(aiModelName("large"), "gpt-4o-mini");
+  });
+});
+
