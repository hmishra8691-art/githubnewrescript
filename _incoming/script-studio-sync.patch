+const COLOR = /^(#[0-9a-f]{3,8}|rgba?\([\d\s.,%/]+\)|hsla?\([\d\s.,%/deg]+\)|[a-z]{3,20}|transparent|currentcolor|color-mix\([a-z\s,#0-9%().-]+\))$/i;
