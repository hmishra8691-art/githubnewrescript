+
+/* ======================================================================
+   PRODUCT SHELL — the menubar (navigation redesign, 2026-09-25)
+
+   Top navigation = what I can do; workspace = what I am doing;
+   contextual panels = controls for the task. The bar is 38 px, opaque,
+   hairline-bordered; a menu is the only thing that ever sits over the
+   workspace and it is gone the moment the pointer leaves it.
+   ====================================================================== */
+:root { --menubar-h: 38px; }
+.menubar {
+  position: relative; z-index: 30; display: flex; align-items: stretch; gap: 8px; height: var(--menubar-h); padding: 0 10px 0 8px;
+  background: var(--c-surface); border-bottom: var(--ide-hairline); user-select: none;
+}
+.menubar-groups { display: flex; align-items: stretch; gap: 2px; min-width: 0; flex: 1 1 auto; }
+.menubar-measure { position: absolute; visibility: hidden; pointer-events: none; top: 0; left: 0; display: flex; gap: 2px; white-space: nowrap; }
+.menubar-group { position: relative; display: flex; align-items: stretch; }
+.menubar-btn {
+  appearance: none; display: inline-flex; align-items: center; gap: 6px; border: 0; background: transparent; padding: 0 10px; margin: 5px 0;
+  border-radius: 7px; font: inherit; font-size: 13px; font-weight: 550; color: var(--ide-ink-2); cursor: pointer; white-space: nowrap; line-height: 1;
+  transition: background var(--dur-1, 120ms) var(--ease, ease), color var(--dur-1, 120ms) var(--ease, ease);
+}
+.menubar-btn .ico, .menubar-btn svg:last-child { color: var(--ide-ink-3); transition: transform var(--dur-1, 120ms) var(--ease, ease); }
+.menubar-btn:hover, .menubar-group.open > .menubar-btn { color: var(--ide-ink); background: var(--c-surface-2); }
+.menubar-group.open > .menubar-btn svg:last-child { transform: rotate(180deg); }
+.menubar-group.here > .menubar-btn { color: var(--ide-ink); }
+.menubar-group.here > .menubar-btn::after { content: ""; position: absolute; left: 10px; right: 10px; bottom: -5px; height: 2px; border-radius: 2px; background: var(--ide-accent); }
+.menubar-btn:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--ide-accent-soft); }
+.menubar-btn-detail { color: var(--ide-ink); font-weight: 600; }
+.menubar-btn .mode-index { color: var(--ide-accent); }
+.menubar-sep { width: 1px; margin: 9px 6px; background: var(--c-border); align-self: stretch; }
+
+/* the menu */
+.menubar-menu {
+  position: absolute; top: calc(100% - 1px); left: 0; min-width: 300px; max-width: min(760px, calc(100vw - 24px)); z-index: 40;
+  background: var(--c-surface); border: var(--ide-hairline); border-radius: 0 0 var(--ide-r) var(--ide-r); box-shadow: 0 14px 34px -10px rgba(19, 26, 43, .22), 0 2px 6px rgba(19, 26, 43, .06);
+  padding: 8px; transform-origin: top left; animation: menubar-in var(--dur-1, 120ms) var(--ease, ease);
+}
+.menubar-menu[hidden] { display: none; }
+.menubar-group:last-of-type .menubar-menu, .menubar-group[data-testid="mode-cluster"] .menubar-menu { left: auto; right: 0; }
+@keyframes menubar-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
+@media (prefers-reduced-motion: reduce) { .menubar-menu { animation: none; } }
+.menubar-grid { display: grid; grid-template-columns: repeat(2, minmax(220px, 1fr)); gap: 2px; }
+.menubar-sections { display: flex; flex-direction: column; gap: 8px; }
+.menubar-section-title { font-family: var(--mono); font-size: var(--ide-mono-fs); letter-spacing: var(--ide-track); text-transform: uppercase; color: var(--ide-ink-3); padding: 6px 10px 2px; }
+.menubar-section-note { text-transform: none; letter-spacing: 0; font-family: inherit; }
+.menubar-section + .menubar-section { border-top: var(--ide-hairline); padding-top: 6px; }
+
+/* an item: icon, name, count, one-line preview */
+.menubar .nav-item {
+  appearance: none; display: flex; align-items: flex-start; gap: 10px; width: 100%; text-align: left; border: 0; background: transparent; border-radius: 7px;
+  padding: 8px 10px; color: var(--ide-ink); font: inherit; cursor: pointer; text-decoration: none; min-width: 0;
+  transition: background var(--dur-1, 120ms) var(--ease, ease);
+}
+.menubar .nav-item:hover, .menubar .nav-item:focus-visible { background: var(--c-surface-2); outline: none; }
+.menubar .nav-item.active { background: var(--c-primary-50); }
+.menubar .nav-item.active .nav-label { color: var(--c-primary-700); }
+.menubar .nav-item:disabled { opacity: .45; cursor: default; }
+.menubar .nav-ico { flex: none; width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; border-radius: 7px; background: var(--c-surface-2); color: var(--ide-ink-2); }
+.menubar .nav-item.active .nav-ico { background: var(--ide-accent-soft); color: var(--ide-accent); }
+.menubar .nav-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
+.menubar .nav-label { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; line-height: 1.2; white-space: nowrap; }
+.menubar .nav-desc { font-size: var(--ide-fs-sm); color: var(--ide-ink-2); line-height: 1.3; }
+.menubar .nav-count { font-family: var(--mono); font-size: 10.5px; font-weight: 600; color: var(--ide-ink-3); background: var(--c-surface-2); border-radius: 999px; padding: 1px 7px; font-variant-numeric: tabular-nums; }
+.menubar .nav-item.active .nav-count { background: var(--ide-accent-soft); color: var(--c-primary-700); }
+.menubar .mode-option { align-items: center; }
+.menubar .mode-option .mode-index { width: 22px; flex: none; text-align: right; font-family: var(--mono); font-size: var(--ide-mono-fs); color: var(--ide-ink-3); }
+.menubar .mode-option.active .mode-index { color: var(--ide-accent); }
+.menubar .mode-option.compact { padding: 6px 10px; }
+.menubar .mode-option.off { color: var(--ide-ink-2); }
+.mode-menu { min-width: 320px; }
+.mode-menu .mode-selector { display: flex; flex-direction: column; gap: 1px; }
+
+/* WHERE AM I */
+.menubar-here { display: inline-flex; align-items: center; gap: 6px; flex: none; padding: 0 4px; font-size: 12.5px; color: var(--ide-ink-2); white-space: nowrap; }
+.here-group { color: var(--ide-ink-3); }
+.here-sep { color: var(--c-border-strong); }
+.here-tab { color: var(--ide-ink); font-weight: 600; }
+.menubar-here .nav-count { margin-left: -2px; }
+.here-mode { display: inline-flex; align-items: center; gap: 5px; margin-left: 8px; padding-left: 10px; border-left: var(--ide-hairline); color: var(--ide-ink); font-weight: 550; }
+.here-mode .mode-index { font-family: var(--mono); font-size: var(--ide-mono-fs); color: var(--ide-accent); }
+.here-split, .here-focus { color: var(--ide-ink-3); font-weight: 500; }
+
+/* FOCUS in Studio mode (brief §8): the menubar tucks into a hairline you
+   hover to reveal; every question card but the selected one goes quiet */
+.ide.focus-studio .menubar { position: absolute; top: var(--topbar-h); left: 0; right: 0; z-index: 15; transform: translateY(calc(-100% + 4px)); transition: transform var(--dur-2, 160ms) var(--ease, ease); box-shadow: none; }
+.ide.focus-studio .menubar::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: var(--ide-accent-soft); }
+.ide.focus-studio .menubar:hover, .ide.focus-studio .menubar:focus-within, .ide.focus-studio .menubar.is-open { z-index: 30; transform: none; box-shadow: 0 10px 24px -12px rgba(19, 26, 43, .3); }
+.ide.focus-studio { position: relative; }
+.ide.focus-studio .qcard:not(.selected) { opacity: .45; transition: opacity var(--dur-2, 160ms) var(--ease, ease); }
+.ide.focus-studio .qcard:not(.selected):hover { opacity: 1; }
+
+/* responsive: labels stay, the detail goes, then the crumb; the bar itself folds groups into More / Menu */
+@media (max-width: 1400px) { .menubar-btn-detail { display: none; } }
+@media (max-width: 1180px) { .here-group, .here-sep { display: none; } .menubar-grid { grid-template-columns: minmax(220px, 1fr); } }
+@media (max-width: 900px) {
+  .menubar { padding: 0 6px; }
+  .menubar-here { display: none; }
+  .menubar-menu { position: fixed; left: 8px !important; right: 8px !important; top: calc(var(--topbar-h) + var(--menubar-h)); max-width: none; max-height: calc(100vh - var(--topbar-h) - var(--menubar-h) - 12px); overflow: auto; border-radius: var(--ide-r); }
+}
+.mode-index { font-family: var(--mono); font-size: var(--ide-mono-fs); letter-spacing: .04em; color: var(--ide-ink-3); }
