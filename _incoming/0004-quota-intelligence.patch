+  assert.deepEqual(none[0].lines.map((l) => l.kind), ["no_data"]);
+  /* men full, women half, other barely moving after 150 completes */
+  const a1 = quotaAdvice(out, { [q.id]: { [men.id]: 90, [women.id]: 58, [other.id]: 2 } })[0];
