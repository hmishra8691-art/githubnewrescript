+      if (!v.optionCode && top.n / answered.length >= DOMINANT) anomaly(`anomaly:dominant:${v.name}`, `${L}: ${pct(top.n / answered.length)} answered “${top.c.label}” — there is almost no variation to analyse.`, [v.name], answered.length);
