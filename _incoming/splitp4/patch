+  const db: RunInsertDb = { from: () => ({ insert: (row) => { inserts.push(row); const a = answers.shift() ?? { error: { message: "no answer" } }; return { select: () => ({ single: async () => ("data" in a ? { data: { id: "r1", ...row }, error: null } : { data: null, error: a.error }) }) }; } }) };
