+  const actions: SurveyAction[] = qs.map((q) => ({ op: "set_display_logic", target: code(q), expression: q.displayLogic ? `${paren(formatCondition(r.def, q.displayLogic))} AND NOT (${expression})` : `NOT (${expression})` }));
