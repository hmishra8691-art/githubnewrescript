+    const re = new RegExp(`(?:^|[^\\p{L}\\p{N}])${l.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}(?:$|[^\\p{L}\\p{N}])`, l.length >= 4 ? "iu" : "u");
