+    if (n.type === "branch") return `${(n.branches ?? []).map((b) => `${titles(b.children)} when ${cond(def, b.when)}`).join("; else ")}${n.otherwise?.length ? `; otherwise ${titles(n.otherwise)}` : ""}`;
