+  const own = parseObjectKey(o.key).kind === "question" ? ix.dependsOn(o.key).filter((e) => parseObjectKey(e.to).kind === "skipRule" && e.to.startsWith(`skipRule:${parseObjectKey(o.key).id}/`)).map((e) => e.to) : [];
