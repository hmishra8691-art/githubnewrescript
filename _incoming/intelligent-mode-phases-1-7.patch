+}
+
+/** `{{NAME…}}` and `{{ed.NAME…}}` at the head of a pipe token — the property, row and modifiers after it are left exactly as written */
+const pipeHead = (name: string) => new RegExp(`(\\{\\{\\s*(?:ed\\.)?)${name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}(?=[\\s.|\\[}])`, "g");
