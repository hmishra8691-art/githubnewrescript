+    const fix = (v: unknown): unknown => {
+      if (Array.isArray(v)) return v.map(fix);
+      if (sameCode(v, from)) { hit = true; return to; }
+      return v;
+    };
+    r.value = fix(r.value);
+    if (r.value2 !== undefined && !String(r.operator).startsWith("rank")) r.value2 = fix(r.value2);
