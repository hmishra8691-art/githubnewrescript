+  const seen = new Set<string>();
+  for (const e of direct) {
+    const s = SECTION_OF[e.kind] ?? "Flow (branches, loops, blocks)";
+    if (seen.has(`${s}|${e.from}`)) continue;
+    seen.add(`${s}|${e.from}`);
+    const d = edgeDetail(r.def, e);
