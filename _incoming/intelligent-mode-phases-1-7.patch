+  const fB = new Map(fields(before).map((f) => [f.name, f])), fA = new Map(fields(after).map((f) => [f.name, f]));
+  const removed = [...fB.values()].filter((f) => !fA.has(f.name)), added = [...fA.values()].filter((f) => !fB.has(f.name));
