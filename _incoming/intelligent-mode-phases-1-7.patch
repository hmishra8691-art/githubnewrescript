+const dependencies: Recogniser = (r) => {
+  const m = /^(?:what|which(?:\s+\w+)?)\s+(?:does|do)\s+(.+?)\s+(?:depend\s+on|read|use|reference|rely\s+on|need|look\s+at)$/i.exec(r.text)
