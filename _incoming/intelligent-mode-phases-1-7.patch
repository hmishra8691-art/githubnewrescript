+    answer: n ? `${o.label} depends on ${plural(n, "object")}: ${[...directKeys].map((k) => ix.nodes.get(k)?.code ?? k).join(", ")}${further.length ? `; ${further.length} more indirectly` : ""}.` : `${o.label} depends on nothing.`,
