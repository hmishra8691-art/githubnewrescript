+  const blocks = fences(md, "");
+  const lines = (b: string) => b.split("\n").map((l) => l.replace(/\s+--.*$/, "").trim()).filter(Boolean);
+  // conditions: the first two fenced blocks
+  const bad: string[] = [];
+  for (const line of [...lines(blocks[0]), ...lines(blocks[1])]) {
